---
const today = new Date();
---
<footer>
<div class="inner">
<span>&copy; {today.getFullYear()} Billy.sh — <a href="https://jd4rider.github.io/billy-web">billy.sh</a> · <a href="https://github.com/jd4rider/billy-app">GitHub</a> · <a href="https://jd4rider.github.io/billy-starlight">Docs</a></span>
</div>
</footer>
<style>
footer {
border-top: 1px solid var(--border);
padding: 2rem 1.5rem;
color: var(--muted);
font-size: 0.85rem;
}
.inner {
max-width: 900px;
margin: 0 auto;
text-align: center;
}
a { color: var(--muted); }
a:hover { color: var(--text); text-decoration: none; }
</style>
